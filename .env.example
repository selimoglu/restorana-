# PostgreSQL. Supabase'de "Transaction pooler" adresini kullanın (port 6543).
# Örnek: postgresql://KULLANICI.PROJE_REF:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=sofra
# Yerelde: postgresql://postgres:postgres@localhost:5432/sofra?schema=sofra
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sofra?schema=sofra"

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer
SESSION_SECRET="degistir-beni-en-az-32-karakter-uzunlugunda"

# Sitenin genel adresi (ödeme dönüşleri ve SEO için)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Claude API (AI özellikleri). Boşsa AI özellikleri demo metinlerle çalışır.
ANTHROPIC_API_KEY=""

# iyzico (boşsa online ödeme demo modunda çalışır)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Netgsm SMS (boşsa SMS'ler sadece loglanır)
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""

# E-posta (Resend). Boşsa e-postalar sadece loglanır.
RESEND_API_KEY=""
EMAIL_FROM="Sofra <bildirim@ornek.com>"

# Günlük otomasyon (cron) çağrıları için gizli anahtar
CRON_SECRET=""
